 def frame_peaks(frame, t, k, floor=SELF_FLOOR, nms=SELF_NMS):
     """The k strongest blobs of one frame, from the image alone: local maxima of |local
-    contrast| (stabilize.local_contrast) above floor. -> (m, 4) rows (t, x, y, |contrast|)."""
+    contrast| (stabilize.local_contrast) above floor. Each 8-connected maximum plateau
+    contributes one actual peak pixel nearest its centroid, with (y, x) breaking ties.
+    Equal-score representatives keep row-major order before top-k truncation.
+    -> (m, 4) rows (t, x, y, |contrast|)."""
     from scipy import ndimage
+    if k <= 0:
+        return np.zeros((0, 4))
     a = np.abs(np.nan_to_num(st.local_contrast(np.asarray(frame, np.float32)), nan=0.0))
     peak = (a == ndimage.maximum_filter(a, size=nms, mode='nearest')) & (a > floor)
-    ys, xs = np.nonzero(peak)
+    labels, count = ndimage.label(peak, structure=np.ones((3, 3), bool))
+    if count == 0:
+        return np.zeros((0, 4))
+    representatives = []
+    for label, region in enumerate(ndimage.find_objects(labels), 1):
+        ys, xs = np.nonzero(labels[region] == label)
+        ys, xs = ys + region[0].start, xs + region[1].start
+        values = a[ys, xs]
+        best = np.flatnonzero(values == values.max())
+        distance = (ys[best] - ys.mean()) ** 2 + (xs[best] - xs.mean()) ** 2
+        chosen = best[np.argmin(distance)]  # nonzero gives row-major (y, x) tie order
+        representatives.append((ys[chosen], xs[chosen]))
+    points = np.asarray(sorted(representatives), dtype=np.int64)
+    ys, xs = points[:, 0], points[:, 1]
     order = np.argsort(-a[ys, xs], kind='stable')[:k]
     return np.stack([np.full(len(order), float(t)), xs[order].astype(float), ys[order].astype(float),
                      a[ys[order], xs[order]].astype(float)], 1).reshape(-1, 4)
